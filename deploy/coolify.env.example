# Coolify runtime env for the realtime service
ALLOWED_ORIGINS=https://game.example.com
LOG_LEVEL=info
ROOM_LOBBY_TTL_MS=7200000
ROOM_GAMEOVER_TTL_MS=900000
SNAPSHOT_DEBOUNCE_MS=250
TRUST_PROXY=true

# Web build args
NEXT_PUBLIC_GAME_MODE=live
# Leave empty for same-origin /rt. Set to https://rt.example.com/rt for the
# two-subdomain fallback.
NEXT_PUBLIC_REALTIME_BASE=
