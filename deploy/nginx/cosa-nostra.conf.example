# Host nginx front door for the Coolify Compose stack.
# Requires loopback ports from compose.yaml:
#   127.0.0.1:3000 -> web
#   127.0.0.1:3001 -> realtime
#
# Install at /etc/nginx/sites-enabled/cosa-nostra.conf.
# Issue the certificate first, for example:
#   certbot --nginx -d cosa-nostra.bindothorpe.com
# Then adjust ssl_certificate paths if certbot uses different names.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name cosa-nostra.bindothorpe.com;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name cosa-nostra.bindothorpe.com;

    ssl_certificate     /etc/letsencrypt/live/cosa-nostra.bindothorpe.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cosa-nostra.bindothorpe.com/privkey.pem;

    client_max_body_size 64k;

    # Realtime HTTP API + WebSocket. Keep the /rt prefix; the server also
    # accepts stripped /health, /rooms and /ws.
    location /rt/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
